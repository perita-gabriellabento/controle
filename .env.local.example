# ============================================================
# Controle de Perícias GB — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# URL do Google Apps Script implantado como Web App
# Obtenha em: Extensions > Apps Script > Deploy > Manage deployments
NEXT_PUBLIC_GAS_URL=https://script.google.com/macros/s/SEU_ID_AQUI/exec

# Token de autenticação — deve ser idêntico ao AUTH_TOKEN no pericias-proxy.gs
NEXT_PUBLIC_GAS_TOKEN=pericias_gb_2026
